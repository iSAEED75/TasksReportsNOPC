<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - سامانه ثبت گزارش کار</title>
    <link href="~/lib/offline/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/offline/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/offline/offline-fonts.css" rel="stylesheet" />
    <style>
        :root {
            --bs-font-sans-serif: "Vazirmatn", "Noto Sans Arabic", Tahoma, Arial, sans-serif;
            --bs-body-font-family: "Vazirmatn", "Noto Sans Arabic", Tahoma, Arial, sans-serif;
        }
        html, body, button, input, select, textarea, option, optgroup {
            font-family: "Vazirmatn", "Noto Sans Arabic", Tahoma, Arial, sans-serif !important;
        }
        body { background: #f4f6f9; color: #233244; }
        .navbar { background: #10243a; }
        .navbar-brand, .nav-link { color: #fff !important; }
        .card { border: 0; box-shadow: 0 2px 12px #10243a12; border-radius: .8rem; }
        .form-control, .form-select, .btn { border-radius: .55rem; }
        textarea { resize: vertical; }
        .page-heading { font-weight: 700; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index"><i class="bi bi-journal-text ms-1"></i> سامانه ثبت گزارش کار</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="نمایش منو"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNavigation">
                <div class="navbar-nav me-auto align-items-lg-center gap-lg-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-link" asp-page="/Tasks/Index"><i class="bi bi-list-check ms-1"></i> گزارش‌ها و وظایف</a>
                        <a class="nav-link" asp-page="/Tasks/Create"><i class="bi bi-plus-circle ms-1"></i> ثبت گزارش یا وظیفه</a>
                        <a class="nav-link" asp-page="/Lists/Index"><i class="bi bi-folder2-open ms-1"></i> فهرست‌های وظایف</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="nav-link" asp-page="/Categories/Index">دسته‌بندی فعالیت‌ها</a>
                            <a class="nav-link" asp-page="/Reports/Index">گزارش‌های آماری</a>
                        }
                        <span class="nav-link"><i class="bi bi-person-circle ms-1"></i>@User.Identity.Name</span>
                        <form method="post" asp-page="/Account/Logout" class="ms-lg-2">
                            <button class="btn btn-sm btn-outline-light" type="submit">خروج</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        @RenderBody()
    </main>
    <footer class="container text-center text-muted small pb-3">سامانه ثبت و مدیریت گزارش کار</footer>
    <script src="~/lib/offline/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
